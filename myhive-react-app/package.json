{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bootstrap": "^5.3.8",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^9.1.0",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.10.1",
    "react-scripts": "5.0.1",
    "remark-gfm": "^4.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(@assistant-ui|nanoid|assistant-stream|assistant-cloud|safe-content-frame|react-day-picker|date-fns|date-fns-jalali|react-markdown|remark-.*|rehype-.*|micromark.*|mdast-.*|unist-.*|unified|bail|is-plain-obj|trough|vfile.*|hast-.*|property-information|html-url-attributes|space-separated-tokens|comma-separated-tokens|devlop|estree-util-is-identifier-name|ccount|escape-string-regexp|markdown-table|trim-lines|decode-named-character-reference|character-entities.*|longest-streak|zwitch)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^unist-util-visit-parents/do-not-use-color$": "<rootDir>/node_modules/unist-util-visit-parents/lib/color.js",
      "^#minpath$": "<rootDir>/node_modules/vfile/lib/minpath.js",
      "^#minproc$": "<rootDir>/node_modules/vfile/lib/minproc.js",
      "^#minurl$": "<rootDir>/node_modules/vfile/lib/minurl.js",
      "^@assistant-ui/tap/react-shim$": "<rootDir>/node_modules/@assistant-ui/tap/dist/react-shim/index.js",
      "^@assistant-ui/tap/react-shim/compiler-runtime$": "<rootDir>/node_modules/@assistant-ui/tap/dist/react-shim/compiler-runtime.js",
      "^@assistant-ui/core/react$": "<rootDir>/node_modules/@assistant-ui/core/dist/react/index.js",
      "^@assistant-ui/core/internal$": "<rootDir>/node_modules/@assistant-ui/core/dist/internal.js",
      "^@assistant-ui/core/store$": "<rootDir>/node_modules/@assistant-ui/core/dist/store/index.js",
      "^@assistant-ui/store/client$": "<rootDir>/node_modules/@assistant-ui/store/dist/client.js",
      "^@assistant-ui/store/internal$": "<rootDir>/node_modules/@assistant-ui/store/dist/internal.js",
      "^assistant-stream/utils$": "<rootDir>/node_modules/assistant-stream/dist/utils.js",
      "^radix-ui/internal$": "<rootDir>/node_modules/radix-ui/dist/internal.js",
      "^assistant-cloud/ai-sdk$": "<rootDir>/node_modules/assistant-cloud/dist/ai-sdk/index.js",
      "^@radix-ui/primitive/is-development$": "<rootDir>/node_modules/@radix-ui/primitive/dist/internal/is-development.true.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1"
  }
}
