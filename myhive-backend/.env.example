# Environment Variables Template
# Copy this to .env file and set your actual values
# DO NOT commit .env to version control!

# Application Profile (dev/prod)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (REQUIRED)
DATABASE_URL=jdbc:postgresql://localhost:5432/myhive_db
DB_USERNAME=myhive_user
DB_PASSWORD=your_secure_database_password_here

# CORS Configuration
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration (Optional - for itinerary confirmations)
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Internal-notification recipient for new bookings
EMAIL_BOOKINGS_TO=booking@trivlu.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Stripe Payments (use TEST keys in dev; get from Stripe Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from `stripe listen` (dev) or Dashboard → Webhooks (prod)
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=eur
PAYMENT_DEPOSIT_PCT=30
