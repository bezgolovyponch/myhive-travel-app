# Environment Variables Template
# Copy this to .env file and set your values

# Application Profile (dev/prod)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (REQUIRED)
DATABASE_URL=jdbc:postgresql://localhost:5432/myhive_db
DB_USERNAME=myhive_user
DB_PASSWORD=your_secure_database_password_here

# CORS Configuration
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Sheets Configuration (REQUIRED for booking system)
GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account-key.json
GOOGLE_SHEETS_SPREADSHEET_ID=1abc123def456ghi789

# Email Configuration (Optional - for itinerary confirmations)
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000
