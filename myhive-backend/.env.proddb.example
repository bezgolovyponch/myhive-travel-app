# The production database from this machine - the proddb profile
# (src/main/resources/application-proddb.properties). Copy this file to .env.proddb (gitignored),
# fill in the values and run:
#     ./gradlew bootRun -Penv=proddb
# The dev setup in .env (H2) stays untouched; -Penv=<name> makes bootRun load .env.<name> instead.
#
# Values: Render -> the Postgres instance -> Connect -> "External Database URL", which has the shape
#     postgresql://<user>:<password>@<host>.frankfurt-postgres.render.com/<database>
# Spring wants it split into the three lines below. Take the EXTERNAL host
# (...frankfurt-postgres.render.com): the internal hostname in the backend service's DATABASE_URL
# only resolves inside Render. Connections from outside Render must use TLS, hence sslmode=require;
# the port is 5432.
#
# Everything the UI writes lands on prod, and email is pinned off, so any action that would mail a
# customer completes WITHOUT the mail - and prod never sends it either, the row already says done:
# closing a vote (result email), starting one (creation email), a booking (confirmation), the contact
# form, a deposit. Reproduce those on the dev profile; use this one to read real data.

SPRING_PROFILES_ACTIVE=prod,proddb

DATABASE_URL=jdbc:postgresql://<host>.frankfurt-postgres.render.com:5432/<database>?sslmode=require
DB_USERNAME=<user>
DB_PASSWORD=<password>

# Stripe: StripeProperties fails fast on blank keys whenever the active profiles contain "prod", and
# this setup does. TEST keys only (the pair from your dev .env) - never the live pair from Render:
# a live key here would open real Checkout sessions against real customer rows.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Images: the prod bucket, so image_url values in the data resolve and a local upload lands where
# prod would put it. The same five values as on Render (your dev .env may already hold them).
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=https://img.trivlu.com

# AI planner, when that is what you debug: the same lines as in your dev .env (key, base url, models).
# AI_ENABLED stays false (the default) so /ai/** is staff-only here as it is on prod.
QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_CHAT_MODEL=
# QWEN_PLANNER_MODEL=

# Deliberately absent: EMAIL_* / RESEND_API_KEY (email is pinned off by the profile), PORT (8080),
# AUTH0_* (the profile defaults to the shared tenant), CORS_ALLOWED_ORIGINS (the default list already
# has localhost:3000), INTERNAL_API_TOKEN (nothing to exempt locally).
