# Server-only: backend base URL INCLUDING its path prefix.
# Read at BUILD time (baked into the rewrite) — rebuild after changing.
# Local Spring serves at root; prod is https://myhive-backend.onrender.com/api
BACKEND_URL=http://localhost:8080

# Browser-visible values (bridged to REACT_APP_* in next.config.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OIDC_AUTHORITY=https://YOUR-TENANT.auth0.com
NEXT_PUBLIC_OIDC_CLIENT_ID=YOUR_CLIENT_ID
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/admin
NEXT_PUBLIC_OIDC_AUDIENCE=https://api.trivlu.com
# REQUIRED: legacy ContactPage.js passes this straight to turnstile.render()
# with no fallback — an empty value breaks the contact form. The value below is
# Cloudflare's "always passes" test sitekey; use the real key on deploys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional (legacy code has defaults):
# NEXT_PUBLIC_OIDC_ROLES_CLAIM=

# Indexing is opt-in: robots.txt (app/robots.ts, read at BUILD time) serves
# Disallow-all unless this is exactly 'true'. Only the production service on
# the canonical domain sets it — previews stay unindexed by default.
# ALLOW_INDEXING=true

# Analytics is silent off the canonical domain: GTM (and therefore the CookieYes
# banner, every event and the Meta Pixel — none of which this app loads directly)
# only initialises on *.trivlu.com. Set this to verify the stack on a preview or
# localhost before the domain cutover.
#
# Setting FORCE without an explicit GTM_ID is now a hard build error: the id
# defaults to the production container, so the forced preview would have pushed
# its clicks into the real GA4 property and Meta audiences.
#
# Two limits that a rendered banner will NOT reveal:
#  - CookieYes has a separate domain allowlist. On a host it does not know, the
#    banner appears but window.getCkyConsent never initialises, so consent is
#    denied by default and the Meta Pixel never loads. Add the host there too.
#  - dataLayer events do not need any of this: utils/analytics.js pushes
#    unconditionally, so `node scripts/verify-analytics.mjs` checks event
#    coverage with GTM off and sends nothing anywhere.
# NEXT_PUBLIC_GTM_FORCE=true
# NEXT_PUBLIC_GTM_ID=GTM-TESTONLY
